# Copiar a app/.env.local y ajustar valores.
# Ninguno de estos valores debe commitearse.

# ── Convex (deployment) ─────────────────────────────────────────────
# Dev local:  local:<team>-<project>
# Cloud dev:  dev:<nombre-del-deployment>
CONVEX_DEPLOYMENT=local:local-mi-team-mi-proyecto

# URLs del deployment. En local apuntan a 3210/3211.
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210
NEXT_PUBLIC_CONVEX_SITE_URL=http://127.0.0.1:3211

# ── Convex Auth ─────────────────────────────────────────────────────
# OJO: estas variables se setean en el deployment, NO en este archivo:
#
#   npx convex env set SITE_URL http://localhost:3000
#   npx convex env set ADMIN_BOOTSTRAP_SECRET <secreto>
#   npx convex env set JWT_PRIVATE_KEY -- "$(cat ruta/clave.pem)"   # multilínea, con --
#   npx convex env set JWKS "$(cat ruta/jwks.json)"
#
# JWT_PRIVATE_KEY en una sola línea rompe el login (cargando infinito).
# Tras cambiarlas hay que volver a empujar: npx convex dev --once
SITE_URL=http://localhost:3000
